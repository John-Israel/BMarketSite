id="159" data-attrid="user_review"><div class="tW5xjb"><div class="aJEtXd" aria-hidden="true"><div class="YbBpX sjBi9c pJ0ITc uhHOwf ez24Df" style="padding-top:100%;" aria-label="imanurseontheside"><img alt="" id="dimg_1919" src="./shoes10_files/unnamed(3).png" data-ilt="1779035978783"></div></div><div class="VB2auf"><div class="cbsD0d">imanurseontheside</div><div class="ZqCnD"><span class="Y0A0hc" aria-label="Rated 5.0 out of 5," role="img"><span class="yi40Hd YrbPuc" aria-hidden="true">5</span><span class="z3HNkc" aria-hidden="true" aria-label="Rated 5.0 out of 5," role="img"><span aria-hidden="true"><span class="gTPtFb" style="background:linear-gradient(to right, currentcolor 70px, #dadce0 0%);"></span></span></span></span><span class="pFMWhd kGnxhb">10 months ago</span></div></div></div><div class="Z1Y8Q"><div class="mhc9re" id="jsuid_1918-title">Literally like walking On Clouds!</div></div><div><div class="GI1h1d" jsname="UtCV2e"><div class="rUzIc" jsname="YodQId" id="jsuid_1918-short" jsaction="trigger.nNRzZb" data-ved="0CKEBEIPyBGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="161" aria-expanded="false" role="button" tabindex="0"><span class="v168Le">My first pair of On were a different style, now discontinued, but they lasted almost 2 years before they looked a bit too worn for work. I chose the black ...</span>&nbsp;<span class="Cf9mYb" aria-label="Read full review by imanurseontheside"><span class="Oz4Oxf" aria-hidden="true">More</span><span class="n9sVdc D5k8Ib z1asCe" style="height:18px;line-height:18px;width:18px;"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"></path></svg></span></span></div><div class="Htu6gf" style="display:none;" jsname="FbqEcd" aria-expanded="true" id="jsuid_1918-full" role="button" tabindex="0" jsaction="trigger.jKkd5b" data-ved="0CKIBEILyBGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="162"><span class="v168Le">My first pair of On were a different style, now discontinued, but they lasted almost 2 years before they looked a bit too worn for work. I chose the black/white in this style and had them 18 months the before they also started to be a bit too worn looking for work. I just purchased them again in the black/white, but also the white, and a pair in the pearl color. All have the same amazing comfy fit that doesn’t require a break in period at all. They do tend to run a bit small since they are a “slip on” style so I go up 1/2 size. The pearl is a great shoe for everyday casual outfits without being too “relaxed” looking. Hope they never stop making this style or change anything about them - they’re perfect!</span>&nbsp;<span class="Cf9mYb" data-less-button="" aria-label="Collapse review"><span class="Oz4Oxf" aria-hidden="true">Less</span><span class="n9sVdc jSGijb z1asCe" style="height:18px;line-height:18px;width:18px;"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path></svg></span></span></div></div></div><div class="xuBzLd">Reviewed on nordstrom.com</div><div class="ADRMee" jscontroller="Fl4WX" jsdata="nZAWxc;;599"><div data-ved="0CKMBELGABGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="163" class="EgwSb v5ZSob" jsname="SOWhFe" aria-controls="ao_1924" aria-owns="ao_1924" aria-label="Open feedback menu for review from imanurseontheside" aria-expanded="false" aria-haspopup="dialog" role="button" tabindex="0" jsaction="w6ghld"><span class="xPrNAe z1asCe" style="height:18px;line-height:18px;width:18px;" jsname="AyaoCf"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path></svg></span></div><div class="NhljOb" style="display:none;" jsname="gV5xaf" id="ao_1924" role="dialog"><span data-ved="0CKQBELKABGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" class="GefpIb" jsname="zU91Wd" role="button" tabindex="0" jsaction="gyMEqe"><span class="Q4mEyd z1asCe"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"></path></svg></span>Provide feedback</span></div></div></div><div class="wKtRYe PZPZlf" jscontroller="Q9sTwd" jsname="B4qqoe" tabindex="-1" jsdata="m0FTcc;;600" jsaction="rcuQ6b:npT2md;nNRzZb:TiglPc;jKkd5b:pJonBb;aeBrn:PBR2fc;keydown:uYT2Vb" data-ved="0CKUBEL3ABWoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="165" data-attrid="user_review"><div class="vgDPUb"><div class="KLEmSd"></div></div><div class="tW5xjb"><div class="aJEtXd" aria-hidden="true"><div class="YbBpX sjBi9c pJ0ITc uhHOwf ez24Df" style="padding-top:100%;" aria-label="Bubleswww"><img alt="" id="dimg_1932" src="./shoes10_files/unnamed(4).png" data-ilt="1779035978783"></div></div><div class="VB2auf"><div class="cbsD0d">Bubleswww</div><div class="ZqCnD"><span class="Y0A0hc" aria-label="Rated 5.0 out of 5," role="img"><span class="yi40Hd YrbPuc" aria-hidden="true">5</span><span class="z3HNkc" aria-hidden="true" aria-label="Rated 5.0 out of 5," role="img"><span aria-hidden="true"><span class="gTPtFb" style="background:linear-gradient(to right, currentcolor 70px, #dadce0 0%);"></span></span></span></span><span class="pFMWhd kGnxhb">a month ago</span></div></div></div><div class="Z1Y8Q"><div class="mhc9re" id="jsuid_1931-title">on cloud 9</div></div><div><div class="GI1h1d" jsname="UtCV2e"><div class="rUzIc" jsname="YodQId" id="jsuid_1931-short" jsaction="trigger.nNRzZb" data-ved="0CKcBEIPyBGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="167" aria-expanded="false" role="button" tabindex="0"><span class="v168Le">These sneakers are AMAZING!!! Super light, super comfortable and great looking. I am typically 6.5, I ordered 6.5 and 7 sizes. I kept size 7 because i like ...</span>&nbsp;<span class="Cf9mYb" aria-label="Read full review by Bubleswww"><span class="Oz4Oxf" aria-hidden="true">More</span><span class="n9sVdc D5k8Ib z1asCe" style="height:18px;line-height:18px;width:18px;"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"></path></svg></span></span></div><div class="Htu6gf" style="display:none;" jsname="FbqEcd" aria-expanded="true" id="jsuid_1931-full" role="button" tabindex="0" jsaction="trigger.jKkd5b" data-ved="0CKgBEILyBGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="168"><span class="v168Le">These sneakers are AMAZING!!! Super light, super comfortable and great looking. I am typically 6.5, I ordered 6.5 and 7 sizes. I kept size 7 because i like when i still have a little extra space around my toes but that doesn't mean that 6.5 was small. It is a personal preference. I was proactive and chose a larger size to avoid my big toe to poke the toe part of the shoes (was sort of close) during running. One other thing, the elastic shoe laces are sort of tight especially for those who have high arch (i do).
Otherwise, AMAZING! We'll recommend to anyone!!!</span>&nbsp;<span class="Cf9mYb" data-less-button="" aria-label="Collapse review"><span class="Oz4Oxf" aria-hidden="true">Less</span><span class="n9sVdc jSGijb z1asCe" style="height:18px;line-height:18px;width:18px;"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path></svg></span></span></div></div></div><div class="xuBzLd">Reviewed on nordstrom.com</div><div class="ADRMee" jscontroller="Fl4WX" jsdata="nZAWxc;;601"><div data-ved="0CKkBELGABGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="169" class="EgwSb v5ZSob" jsname="SOWhFe" aria-controls="ao_1937" aria-owns="ao_1937" aria-label="Open feedback menu for review from Bubleswww" aria-expanded="false" aria-haspopup="dialog" role="button" tabindex="0" jsaction="w6ghld"><span class="xPrNAe z1asCe" style="height:18px;line-height:18px;width:18px;" jsname="AyaoCf"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path></svg></span></div><div class="NhljOb" style="display:none;" jsname="gV5xaf" id="ao_1937" role="dialog"><span data-ved="0CKoBELKABGoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" class="GefpIb" jsname="zU91Wd" role="button" tabindex="0" jsaction="gyMEqe"><span class="Q4mEyd z1asCe"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"></path></svg></span>Provide feedback</span></div></div></div></div><div class="GTERze hb4WBd"><div class="Cojuac" jsname="u55Kub"><div class="EUZsD"><div class="p8FEIf TOQyFc TQc1id MmMIvd jRKCUd" jsaction="click:trigger.MS0zad" data-l="" role="button" tabindex="0" data-ved="0CKsBEMXABWoXChMIwN6kj-HAlAMVAAAAAB0AAAAAEDA" data-hveid="171"><hr class